@model Product

<div class="card shadow-lg rounded-lg border-0 overflow-hidden m-2" style="max-width: 300px;">
    @* <img src="@Model.ImageUrl" alt="@Model.Name" class="card-img-top" style="height: 200px; object-fit: cover;"> *@

    <div class="card-body text-center">
        <h5 class="card-title font-weight-bold">@Model.Name</h5>

        <p class="card-text text-muted small">
            @Model.Description.Substring(0, Math.Min(80, Model.Description.Length))...
        </p>

        <h6 class="text-primary font-weight-bold">@Model.Price.ToString("c")</h6>

        <a href="#" class="btn btn-success btn-sm rounded-pill mt-2">
            <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
        </a>
    </div>
</div>
