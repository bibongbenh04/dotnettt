@model CourseRegistration.Models.Entities.Section

@{
    ViewData["Title"] = "Create Section";
}

<h1>Create Section</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Section Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="CourseId" class="control-label">Course</label>
                        <select asp-for="CourseId" class="form-control">
                            <option value="">-- Select Course --</option>
                            @foreach (var course in ViewBag.Courses)
                            {
                                <option value="@course.Id" selected="@(Model.CourseId == course.Id)">
                                    @course.Code - @course.Title
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="SectionNumber" class="control-label">Section Number</label>
                        <input asp-for="SectionNumber" class="form-control" />
                        <span asp-validation-for="SectionNumber" class="text-danger"></span>
                        <small class="form-text text-muted">Enter a section number (e.g., 001, 002, A, B)</small>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Semester" class="control-label">Semester</label>
                                <select asp-for="Semester" class="form-control">
                                    <option value="Spring">Spring</option>
                                    <option value="Summer">Summer</option>
                                    <option value="Fall">Fall</option>
                                </select>
                                <span asp-validation-for="Semester" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Year" class="control-label">Year</label>
                                <input asp-for="Year" class="form-control" type="number" min="2023" max="2030" />
                                <span asp-validation-for="Year" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Instructor" class="control-label">Instructor</label>
                        <input asp-for="Instructor" class="form-control" />
                        <span asp-validation-for="Instructor" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Schedule" class="control-label">Schedule</label>
                        <input asp-for="Schedule" class="form-control" placeholder="e.g., MWF 10:00-10:50" />
                        <span asp-validation-for="Schedule" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Location" class="control-label">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g., Science Building 101" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Capacity" class="control-label">Capacity</label>
                        <input asp-for="Capacity" class="form-control" type="number" min="1" max="500" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="RegistrationDeadline" class="control-label">Registration Deadline</label>
                        <input asp-for="RegistrationDeadline" class="form-control" type="date" />
                        <span asp-validation-for="RegistrationDeadline" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mt-4">
                        <input type="submit" value="Create" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}