@model IEnumerable<CourseRegistration.Models.Entities.Course>

@{
    ViewData["Title"] = "Courses";
}

<h1>Courses</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Course</a>
</p>

@if (ViewBag.Departments != null)
{
    <div class="mb-4">
        <h5>Filter by Department:</h5>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn @(Context.Request.Query["departmentId"].Count == 0 ? "btn-primary" : "btn-outline-primary")">All</a>
            @foreach (var dept in ViewBag.Departments)
            {
                <a asp-action="Index" asp-route-departmentId="@dept.Id" 
                   class="btn @(Context.Request.Query["departmentId"] == dept.Id.ToString() ? "btn-primary" : "btn-outline-primary")">
                    @dept.Code - @dept.Name
                </a>
            }
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No courses found. Please create a new course or select a different department.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Title</th>
                <th>Credits</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Title</td>
                    <td>@item.Credits</td>
                    <td>@item.Department?.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}